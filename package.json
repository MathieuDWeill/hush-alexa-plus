{
  "name": "hush-alexa-plus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Alexa+ hackathon submission: a self-hosted Streamable HTTP MCP server that decides what a household assistant says out loud, plus a simulated Alexa+ surface driven by that same endpoint.",
  "scripts": {
    "dev": "npm run build && node --watch dist/src/index.js",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "smoke": "bash scripts/smoke-test.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test dist/tests/*.test.js",
    "probe": "bash scripts/mcp-probe.sh",
    "studio:voice": "node studio/vo.mjs --force",
    "studio:capture": "node studio/capture.mjs",
    "studio:assemble": "node studio/assemble.mjs",
    "studio:video": "npm run build && node studio/vo.mjs --force && node studio/capture.mjs && node studio/assemble.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "playwright": "^1.64.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
